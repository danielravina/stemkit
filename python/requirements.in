# Exact pins for the engine venv bootstrap (src/main/env.ts bootstrap()).
# Versions mirror a known-good install; the lock file carries sha256 hashes
# for every artifact so pip can't silently install something else.
#
# Regenerate the lock after changing a pin:
#   uv pip compile python/requirements.in --universal --generate-hashes \
#     -o python/requirements.lock
